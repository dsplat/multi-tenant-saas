# ============================================================
# 租户域名基桩（自动生成 — 勿手改，由 domains:generate-nginx 渲染）
#
# 作为 default_server，捕获所有「无显式 vhost」的域名：
#   - 租户自定义域名（tenants.domain）
#   - 租户二级域名（{slug}.<wildcard_base>、{tenant_id}.<wildcard_base>）
#   - 恶意/未配置域名 → $domain_allowed=0 → return 444（nginx 层拦截，不进 PHP）
#
# 监听形态由 domain.nginx_listen_mode 决定：
#   https — 443 直连，证书按 SNI 动态选择（maps/ssl.map）
#   http  — 80 层（SLB 已卸载 SSL），无证书指令
# 域名白名单由 maps/tenant-auth.map 提供 $domain_allowed。
# ============================================================

server {
    {{LISTEN}}
    server_name _;

    {{SSL_BLOCK}}

    # ★ nginx 层域名合法性拦截：未在白名单的域名直接断连（零带宽、零信息泄露）
    if ($domain_allowed = 0) {
        return 444;
    }

    # ★ GEO（生成式引擎优化）防护：拦截各厂 AI 爬虫
    #   仅对「非收录域名」（平台子域名含 t-xxxxxx，$seo_allowed=0）拦截 AI 爬虫；
    #   收录域名（平台域名/租户自定义域名，$seo_allowed=1）放行 AI 爬虫（GEO 开放）。
    #   $block_ai_bot = ($is_ai_bot=1 且 $seo_allowed=0)，由 maps/bot.map 派生。
    if ($block_ai_bot) {
        return 403;
    }

    # ★ SEO/GEO 隔离：非收录域名（平台子域名含 t-xxxxxx）下发 noindex 响应头
    #   值由 map $seo_allowed $x_robots_tag 提供；收录域名置空不下发。
    #   注意 nginx add_header 继承规则：location 内另有 add_header 时须自行补充（见 /h5/ /console/）
    add_header X-Robots-Tag $x_robots_tag always;

    root {{ROOT}};
    index index.html;

    # AI 流式（SSE）→ Node 引擎（ai-streaming:nginx 生成的 snippet）
    {{AI_STREAMING_INCLUDE}}

    # API → 直连 php-fpm（废除 9100 nginx 代理层；Host 头经 fastcgi 天然透传给 IdentifyTenant）
    location /api/ {
        try_files $uri /index.php?$query_string;
    }

    # robots.txt：按 $seo_allowed 动态下发（收录域名开放；子域名含 t- 限制禁收）
    location = /robots.txt {
        default_type "text/plain";
        add_header X-Robots-Tag $x_robots_tag always;
        if ($seo_allowed = 1) {
            # Sitemap 指向项目层 PHP 直出路由（如 scrm Seo 模块 /sitemap.xml）；
            # 未实现该路由时返回 404，不影响收录。索引一律走 https。
            return 200 "User-agent: *\nAllow: /\nSitemap: https://$host/sitemap.xml\n";
        }
        return 200 "User-agent: *\nDisallow: /\n";
    }

    location ~ [^/]\.php(/|$) {
        try_files $uri =404;
        fastcgi_pass {{FASTCGI_PASS}};
        fastcgi_index index.php;
        include fastcgi.conf;
        # 防伪：以真实 Host 覆盖客户端传入的 X-Original-Host（隔离门依赖此头）
        fastcgi_param HTTP_X_ORIGINAL_HOST $host;
        {{FASTCGI_HTTPS_PARAM}}fastcgi_buffering off;
        fastcgi_read_timeout 300s;
    }

    # SEO 直出分流（由 domains:generate-nginx 渲染，路径列表来自 domain.seo_direct_out_paths）
    # 爬虫（$is_seo_or_ai_bot=1）→ PHP 直出；真人 → 落回 SPA。默认空配置不渲染任何 location。
    {{SEO_DIRECT_OUT_LOCATIONS}}

    # H5 终端用户 SPA
    location ^~ /h5/ {
        add_header Cache-Control "no-cache";
        add_header X-Robots-Tag $x_robots_tag always;
        alias {{ROOT}}/h5/;
        index index.html;
        try_files $uri $uri/ /h5/index.html;
    }

    # Console SPA
    location ^~ /console/ {
        add_header Cache-Control "no-cache";
        add_header X-Robots-Tag $x_robots_tag always;
        alias {{ROOT}}/console/;
        index index.html;
        try_files $uri $uri/ /console/index.html;
    }

    # 根路径跳转 H5
    location = / {
        return 302 /h5/;
    }

    # 静态资源缓存
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        expires 30d;
        add_header Cache-Control "public";
    }

    # 平台归属验证文件 → PHP 动态服务（VerificationFileController）
    # 最长前缀优先于下方 ACME location；验证文件必须在域名未生效（pending）时即可访问
    location ^~ /.well-known/tenant-verify/ {
        try_files $uri /index.php?$query_string;
    }

    # 第三方平台（微信/企微/支付宝）域名验证文件 → PHP 动态服务（VerificationFileController）
    # 微信要求访问域名根路径 WW_verify_xxx.txt / MP_verify_xxx.txt / alipay_verify_xxx.txt
    location ~* ^/(WW_verify|MP_verify|alipay_verify|verify_)[A-Za-z0-9]{8,64}\.txt$ {
        try_files $uri /index.php?$query_string;
    }

    # ACME 证书挑战（静态文件，放 public/.well-known/acme-challenge/）
    location ^~ /.well-known/ {
        allow all;
        default_type "text/plain";
    }

    location ~ /\.(?!well-known) {
        deny all;
    }

    access_log {{LOG_DIR}}/tenant-domains.log;
    error_log  {{LOG_DIR}}/tenant-domains.error.log;
}
