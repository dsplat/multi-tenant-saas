# ============================================================
# 租户域名基桩（自动生成 — 勿手改，由 domains:generate-nginx 渲染）
#
# 作为 443 端口的 default_server，捕获所有「无显式 vhost」的域名：
#   - 租户自定义域名（tenants.domain）
#   - 租户二级域名（{slug}.<wildcard_base>）
#   - 恶意/未配置域名 → $domain_allowed=0 → return 444（nginx 层拦截，不进 PHP）
#
# 证书按 SNI 动态选择（maps/ssl.map 提供 $ssl_cert_file / $ssl_key_file）。
# 域名白名单由 maps/tenant-auth.map 提供 $domain_allowed。
#
# 说明：HTTP(80)→HTTPS 重定向由系统 nginx.conf 的 80 端口 default_server 统一处理，
#       本基桩仅负责 443，避免重复声明 default_server。
# ============================================================

server {
    listen 443 ssl http2 default_server;
    server_name _;

    # SNI 动态证书
    ssl_certificate     $ssl_cert_file;
    ssl_certificate_key $ssl_key_file;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    ssl_ciphers "TLS13-AES-256-GCM-SHA384:TLS13-CHACHA20-POLY1305-SHA256:TLS13-AES-128-GCM-SHA256:EECDH+CHACHA20:EECDH+AES128:RSA+AES128:EECDH+AES256:RSA+AES256:!MD5";
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 5m;

    # ★ nginx 层域名合法性拦截：未在白名单的域名直接断连（零带宽、零信息泄露）
    if ($domain_allowed = 0) {
        return 444;
    }

    # ★ GEO（生成式引擎优化）防护：拦截各厂 AI 爬虫（map $http_user_agent $is_ai_bot）
    #   平台无法控制租户内容，统一禁止 AI 爬虫抓取训练/检索
    if ($is_ai_bot) {
        return 403;
    }

    # ★ SEO/GEO 隔离：非收录域名（平台子域名含 t-xxxxxx）下发 noindex 响应头
    #   值由 map $seo_allowed $x_robots_tag 提供；收录域名置空不下发。
    #   注意 nginx add_header 继承规则：location 内另有 add_header 时须自行补充（见 /h5/ /console/）
    add_header X-Robots-Tag $x_robots_tag always;

    root {{ROOT}};
    index index.html;

    # AI 流式（SSE）→ Node 引擎（ai-streaming:nginx 生成的 snippet）
    {{AI_STREAMING_INCLUDE}}

    # API → 直连 php-fpm（废除 9100 nginx 代理层；Host 头经 fastcgi 天然透传给 IdentifyTenant）
    location /api/ {
        try_files $uri /index.php?$query_string;
    }

    # robots.txt：按 $seo_allowed 动态下发（收录域名开放；子域名含 t- 限制禁收）
    location = /robots.txt {
        default_type "text/plain";
        add_header X-Robots-Tag $x_robots_tag always;
        if ($seo_allowed = 1) {
            return 200 "User-agent: *\nAllow: /\n";
        }
        return 200 "User-agent: *\nDisallow: /\n";
    }

    location ~ [^/]\.php(/|$) {
        try_files $uri =404;
        fastcgi_pass 127.0.0.1:{{FPM_PORT}};
        fastcgi_index index.php;
        include fastcgi.conf;
        fastcgi_param HTTPS on;
        fastcgi_buffering off;
        fastcgi_read_timeout 300s;
    }

    # H5 终端用户 SPA
    location ^~ /h5/ {
        add_header Cache-Control "no-cache";
        add_header X-Robots-Tag $x_robots_tag always;
        alias {{ROOT}}/h5/;
        index index.html;
        try_files $uri $uri/ /h5/index.html;
    }

    # Console SPA
    location ^~ /console/ {
        add_header Cache-Control "no-cache";
        add_header X-Robots-Tag $x_robots_tag always;
        alias {{ROOT}}/console/;
        index index.html;
        try_files $uri $uri/ /console/index.html;
    }

    # 根路径跳转 H5
    location = / {
        return 302 /h5/;
    }

    # 静态资源缓存
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        expires 30d;
        add_header Cache-Control "public";
    }

    # ACME / 域名归属验证
    location ^~ /.well-known/ {
        allow all;
        default_type "text/plain";
    }

    location ~ /\.(?!well-known) {
        deny all;
    }

    access_log {{LOG_DIR}}/tenant-domains.log;
    error_log  {{LOG_DIR}}/tenant-domains.error.log;
}
