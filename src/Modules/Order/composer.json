{
  "name": "dsplat/multi-tenant-saas-module-order",
  "version": "1.0.0",
  "description": "统一订单中心 - 一切交易皆订单（orders/order_items/consumption_records），履约 Registry 扩展点与 OrderPaid/OrderRefunded 框架事件",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "MultiTenantSaas\\Modules\\Order\\": ""
    }
  },
  "require": {
    "php": "^8.3",
    "dsplat/multi-tenant-saas": "*"
  },
  "extra": {
    "saas": {
      "name": "order",
      "priority": 7,
      "dependencies": ["product", "pay"],
      "conflicts": [],
      "requires_core": ">=1.0.0",
      "provider": "MultiTenantSaas\\Modules\\Order\\OrderServiceProvider",
      "tenant_toggleable": true,
      "default_enabled": true
    }
  }
}
